{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)scripts' ':(exclude)app' ':(exclude)docs' ':(exclude).github' ':(exclude).claude' ':(exclude)CLAUDE.md' ':(exclude)README.md' ':(exclude)extension'",
  "git": {
    "deploymentEnabled": {
      "claude/*": false,
      "claude/web-improvements-cyber-app-kq7rww": false
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(ttf|woff2?)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!redes/).*)\\.(png|jpe?g|webp|svg|ico|mp4|webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/redes/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/observatorio/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; manifest-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/guias/(guias|lista)\\.json",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/guias(/[a-z0-9-]*)?(/)?",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'unsafe-inline'; font-src 'self'; img-src 'self' data:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; manifest-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none';"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/vera",
      "destination": "/api/vera"
    },
    {
      "source": "/agente",
      "destination": "/agente/index.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon-48.png"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/guias",
      "destination": "/guias/index.html"
    },
    {
      "source": "/guias/:slug([a-z0-9-]+)",
      "destination": "/guias/:slug/index.html"
    },
    {
      "source": "/observatorio/:slug([a-z0-9-]+)",
      "destination": "/api/estafa?slug=:slug"
    },
    {
      "source": "/tarjetas/semana-:fecha(\\d{8}).png",
      "destination": "/api/tarjeta?modo=semana"
    },
    {
      "source": "/tarjetas/caso/:d([A-Za-z0-9_-]+).:s([a-f0-9]{32}).png",
      "destination": "/api/tarjeta?modo=caso&d=:d&s=:s"
    },
    {
      "source": "/api/alerta-semanal",
      "destination": "/api/tarjeta?modo=alerta"
    },
    {
      "source": "/api/stats",
      "destination": "/api/observatorio-stats?vista=eventos"
    }
  ],
  "functions": {
    "api/estafa.js": {
      "includeFiles": "observatorio/datos.json"
    },
    "api/sitemap.js": {
      "includeFiles": "{observatorio/datos.json,guias/lista.json}"
    },
    "api/app/verificar.js": {
      "maxDuration": 30
    },
    "api/agente/consulta.js": {
      "maxDuration": 60
    },
    "api/tarjeta.js": {
      "includeFiles": "{observatorio/datos.json,observatorio/claves.json,logo-cm.png,tarjetas/img/*.png,tarjetas/fuentes/*.ttf}",
      "maxDuration": 20
    }
  }
}
