{
  "manifest_version": 3,
  "name": "Vera Antiestafas · Cyber Mobile",
  "short_name": "Vera",
  "version": "1.3.0",
  "description": "¿Es estafa? Verificá links, páginas, CBU, teléfonos, mails y capturas con Vera. Te muestra en una terminal qué fuentes consulta y en qué se basa el informe.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Vera Antiestafas",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.cybermobile.com.ar/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "homepage_url": "https://www.cybermobile.com.ar/"
}